{
    "private": true,
    "workspaces": [
        "packages/editor",
        "packages/website"
    ],
    "scripts": {
        "start:website": "npm --workspace=@fbe/website run start",
        "preview:website": "npm --workspace=@fbe/website run preview",
        "start:exporter": "cd ./packages/exporter && cargo run --release",
        "build:website": "npm --workspace=@fbe/website run build",
        "type-check": "tsc",
        "type-check:ratchet": "node scripts/ratchet.mjs typecheck",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:ratchet": "node scripts/ratchet.mjs lint",
        "format": "prettier . --check",
        "format:fix": "prettier . --write",
        "check": "npm run format && npm run lint:ratchet && npm run type-check:ratchet && npm test"
    },
    "devDependencies": {
        "@eslint/js": "9.36.0",
        "@types/node": "22.13.0",
        "eslint": "9.36.0",
        "prettier": "3.6.2",
        "typescript": "5.9.2",
        "typescript-eslint": "8.44.1",
        "vitest": "3.2.4"
    }
}
